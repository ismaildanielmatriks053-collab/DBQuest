rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 50 &&
             data.totalPoints is int && data.totalPoints >= 0 && data.totalPoints <= 10000000 &&
             data.quizzesCompleted is int && data.quizzesCompleted >= 0 && data.quizzesCompleted <= 100000 &&
             data.quizzesWon is int && data.quizzesWon >= 0 && data.quizzesWon <= 100000 &&
             data.diagramsSolved is int && data.diagramsSolved >= 0 && data.diagramsSolved <= 100000 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 100000 &&
             data.bestStreak is int && data.bestStreak >= 0 && data.bestStreak <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuiz(data) {
      return data.creatorId is string && data.creatorId.size() >= 1 && data.creatorId.size() <= 128 &&
             data.lecturerName is string && data.lecturerName.size() >= 2 && data.lecturerName.size() <= 60 &&
             data.lecturerTitle is string && data.lecturerTitle.size() >= 2 && data.lecturerTitle.size() <= 60 &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 100 &&
             data.topic is string && data.topic.size() >= 2 && data.topic.size() <= 40 &&
             data.difficulty in ['Beginner', 'Intermediate', 'Advanced'] &&
             data.visibility == 'public' &&
             data.timePerQuestionSec is int && data.timePerQuestionSec >= 5 && data.timePerQuestionSec <= 60 &&
             data.passThresholdPercent is int && data.passThresholdPercent >= 40 && data.passThresholdPercent <= 100 &&
             data.xpReward is int && data.xpReward >= 50 && data.xpReward <= 1000 &&
             data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 15 &&
             data.questions[0] is map &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidQuizResult(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.quizId is string && data.quizId.size() >= 1 && data.quizId.size() <= 128 &&
             data.quizTitle is string && data.quizTitle.size() >= 1 && data.quizTitle.size() <= 100 &&
             data.lecturerName is string && data.lecturerName.size() >= 1 && data.lecturerName.size() <= 60 &&
             data.score is int && data.score >= 0 && data.score <= 100000 &&
             data.correctCount is int && data.correctCount >= 0 && data.correctCount <= 15 &&
             data.totalQuestions is int && data.totalQuestions >= 1 && data.totalQuestions <= 15 &&
             data.accuracyPercent is int && data.accuracyPercent >= 0 && data.accuracyPercent <= 100 &&
             data.outcome in ['WIN', 'LOSS'] &&
             data.pointsEarned is int && data.pointsEarned >= 0 && data.pointsEarned <= 5000 &&
             data.maxStreak is int && data.maxStreak >= 0 && data.maxStreak <= 15 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidDiagramAttempt(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.challengeId is string && data.challengeId.size() >= 1 && data.challengeId.size() <= 64 &&
             data.challengeTitle is string && data.challengeTitle.size() >= 1 && data.challengeTitle.size() <= 100 &&
             data.verdictTitle is string && data.verdictTitle.size() >= 1 && data.verdictTitle.size() <= 100 &&
             data.feedbackSummary is string && data.feedbackSummary.size() >= 1 && data.feedbackSummary.size() <= 1200 &&
             data.score is int && data.score >= 0 && data.score <= 100 &&
             data.passed is bool &&
             data.xpAwarded is int && data.xpAwarded >= 0 && data.xpAwarded <= 1000 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- Collection Rules ---

    // 1. User Profiles (strictly owner-isolated)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
                       isOwner(userId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'totalPoints', 'quizzesCompleted', 'quizzesWon', 'diagramsSolved', 'currentStreak', 'bestStreak', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'totalPoints', 'quizzesCompleted', 'quizzesWon', 'diagramsSolved', 'currentStreak', 'bestStreak', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isValidId(userId) &&
                       isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'totalPoints', 'quizzesCompleted', 'quizzesWon', 'diagramsSolved', 'currentStreak', 'bestStreak', 'updatedAt']);

      allow delete: if isValidId(userId) && isOwner(userId);

      // 1a. Quiz Results subcollection (owner-scoped via {userId})
      match /quizResults/{resultId} {
        allow get: if isValidId(userId) && isValidId(resultId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(resultId) &&
                         isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'quizId', 'quizTitle', 'lecturerName', 'score', 'correctCount', 'totalQuestions', 'accuracyPercent', 'outcome', 'pointsEarned', 'maxStreak', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'quizId', 'quizTitle', 'lecturerName', 'score', 'correctCount', 'totalQuestions', 'accuracyPercent', 'outcome', 'pointsEarned', 'maxStreak', 'createdAt']) &&
                         isValidQuizResult(incoming());

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(resultId) && isOwner(userId);
      }

      // 1b. Diagram Attempts subcollection (owner-scoped via {userId})
      match /diagramAttempts/{attemptId} {
        allow get: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
                         isValidId(attemptId) &&
                         isOwner(userId) &&
                         incoming().userId == request.auth.uid &&
                         incoming().keys().hasAll(['userId', 'challengeId', 'challengeTitle', 'verdictTitle', 'feedbackSummary', 'score', 'passed', 'xpAwarded', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'challengeId', 'challengeTitle', 'verdictTitle', 'feedbackSummary', 'score', 'passed', 'xpAwarded', 'createdAt']) &&
                         isValidDiagramAttempt(incoming());

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(attemptId) && isOwner(userId);
      }
    }

    // 2. Lecturer Quizzes (publicly playable when visibility == 'public', editable only by creator)
    match /quizzes/{quizId} {
      allow get: if isValidId(quizId) && isSignedIn() && (existing().visibility == 'public' || existing().creatorId == request.auth.uid);
      allow list: if isSignedIn() && existing().visibility == 'public';

      allow create: if isValidId(quizId) &&
                       isSignedIn() &&
                       incoming().creatorId == request.auth.uid &&
                       incoming().keys().hasAll(['creatorId', 'lecturerName', 'lecturerTitle', 'title', 'topic', 'difficulty', 'visibility', 'timePerQuestionSec', 'passThresholdPercent', 'xpReward', 'questions', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['creatorId', 'lecturerName', 'lecturerTitle', 'title', 'topic', 'difficulty', 'visibility', 'timePerQuestionSec', 'passThresholdPercent', 'xpReward', 'questions', 'createdAt', 'updatedAt']) &&
                       isValidQuiz(incoming());

      allow update: if isValidId(quizId) &&
                       isSignedIn() &&
                       isValidQuiz(incoming()) &&
                       existing().creatorId == request.auth.uid &&
                       incoming().creatorId == existing().creatorId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['lecturerName', 'lecturerTitle', 'title', 'topic', 'difficulty', 'visibility', 'timePerQuestionSec', 'passThresholdPercent', 'xpReward', 'questions', 'updatedAt']);

      allow delete: if isValidId(quizId) && isSignedIn() && existing().creatorId == request.auth.uid;
    }
  }
}
